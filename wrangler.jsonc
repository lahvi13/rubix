{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubix",
  "compatibility_date": "2026-09-01",
  // Public URL: https://rubix.<account>.workers.dev
  "workers_dev": true,
  // Per-branch preview URLs — used to test PWA behaviour on a phone before merging.
  "preview_urls": true,
  // Assets-only Worker: no server code, just the built PWA.
  "assets": {
    "directory": "./dist",
    // Client-side routing — unknown paths serve index.html instead of 404.
    "not_found_handling": "single-page-application"
  }
}
