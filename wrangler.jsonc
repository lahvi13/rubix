{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubix",
  "compatibility_date": "2026-09-01",
  // Production is served from the custom domain https://rubix.lahvi.cz only.
  // Keeping the origin stable matters: IndexedDB is scoped to it.
  "workers_dev": false,
  // Per-branch preview URLs — used to test PWA behaviour on a phone before merging.
  // Must stay explicit: preview URLs default to whatever workers_dev is, so
  // dropping this line would disable them. Verified working with workers_dev off.
  "preview_urls": true,
  // Assets-only Worker: no server code, just the built PWA.
  "assets": {
    "directory": "./dist",
    // A real 404 for paths that do not exist. The app routes by hash, so it
    // never needs another path to answer with index.html — and doing so told
    // crawlers that /ai-catalog.json, /.well-known/* and friends exist as HTML.
    // An installed app is unaffected: its service worker answers navigations.
    "not_found_handling": "none"
  }
}
